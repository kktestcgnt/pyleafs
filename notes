->first need to create the jenkins_home folder in root repository(pyleafs)
cmd> docker run -d   --name jenkins   -p 8080:8080   -p 50000:50000   -v jenkins_home:/var/jenkins_home   jenkins/jenkins:lts
cmd>docker exec -it -u root jenkins bash
cmd>apt update
cmd>apt install -y python3 python3-pip
cmd>python3 --version

->create the Jenkinsfile
pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/kktestcgnt/pyleafs.git'
            }
        }

        stage('Run Python File') {
            steps {
                sh '''
                echo "Checking Python version"
                python3 --version

                echo "Running sample.py"
                python3 Jenkins_python.py
                '''
            }
        }
    }
}

->create Jenkins_python.py File
print("This file is in pyleaf rep of github of kktestcgnt/pyleafs")

->docker start jenkins
        ->click new item
        ->give name to jenkins job(run-sample-file)
        ->click on pipeline
        ->In definition click below one
                pipeline script from SCM
        ->In SCM select below one
                git
        ->Click Repositorys
                In repository url fill with below
                        eg : https://github.com/kktestcgnt/pyleafs.git

        ->In Branch specifier fill with below
                    */main

        ->click ok to create a pipeline
        ->click on job created and then click on build now